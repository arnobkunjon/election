{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/promise-ledger/promise-ledger/spec/schema/election.schema.json",
  "title": "Promise Format v0.1 - Election",
  "type": "object",
  "required": ["id", "countryCode", "electionTypeId", "regionId", "names", "status", "dates"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$",
      "description": "Stable election id, unique across the ledger."
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[a-z]{2}$",
      "description": "ISO 3166-1 alpha-2, lowercase. Must match country.json country.code."
    },
    "electionTypeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,40}$",
      "description": "Must exist in the country's electionTypes."
    },
    "regionId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "The region where this election is held. Must exist in regions.json and its level must equal the election type's regionLevel."
    },
    "names": { "$ref": "#/$defs/localizedString" },
    "status": {
      "type": "string",
      "enum": ["draft", "open", "locked", "governing", "closed"],
      "description": "Lifecycle status. Moves only forward: draft -> open -> locked -> governing -> closed."
    },
    "dates": {
      "type": "object",
      "required": ["nominationOpens", "electionDay", "termStart", "termEnd"],
      "additionalProperties": false,
      "properties": {
        "nominationOpens": { "$ref": "#/$defs/isoDate" },
        "electionDay": { "$ref": "#/$defs/isoDate" },
        "termStart": { "$ref": "#/$defs/isoDate" },
        "termEnd": { "$ref": "#/$defs/isoDate" }
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Calendar date, ISO 8601 (YYYY-MM-DD)."
    },
    "localizedString": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 },
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" },
      "description": "Map of locale to text. Locales must be declared in the country's country.json."
    }
  }
}
